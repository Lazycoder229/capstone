{
  "name": "qrots",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "migration": "typeorm-ts-node-esm",
    "migration:generate": "typeorm-ts-node-esm migration:generate lib/database/migrations/InitialSchema -d lib/database/data-source.ts",
    "migration:generate:update": "typeorm-ts-node-esm migration:generate lib/database/migrations/UpdateSchema -d lib/database/data-source.ts",
    "migration:run": "typeorm-ts-node-esm migration:run -d lib/database/data-source.ts",
    "migration:run:script": "node --loader ts-node/esm lib/database/run-migrations.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d lib/database/data-source.ts"
  },
  "dependencies": {
    "@auth/typeorm-adapter": "^2.11.3",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.42.0",
    "mysql2": "^3.24.4",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.87.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "typeorm": "^0.3.26",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
